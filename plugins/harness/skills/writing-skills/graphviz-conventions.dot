digraph STYLE_GUIDE {
    // 手順を描く DSL の書式を、その DSL 自体で書いたもの

    // ノードの種類と形
    subgraph cluster_node_types {
        label="ノードの種類と形";

        // 問いはひし形
        "これは問いか?" [shape=diamond];

        // 行動は箱 (既定)
        "行動する" [shape=box];

        // コマンドは plaintext
        "git commit -m 'msg'" [shape=plaintext];

        // 状態は楕円
        "今の状態" [shape=ellipse];

        // 警告は八角形
        "STOP: 重大な警告" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];

        // 入口と出口は二重丸
        "手順の開始" [shape=doublecircle];
        "手順の完了" [shape=doublecircle];

        // それぞれの例
        "テストは通っている?" [shape=diamond];
        "先にテストを書く" [shape=box];
        "npm test" [shape=plaintext];
        "行き詰まっている" [shape=ellipse];
        "git add -A は決して使わない" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];
    }

    // 辺のラベルの付け方
    subgraph cluster_edge_types {
        label="辺のラベル";

        "二択の判断?" [shape=diamond];
        "yes の道" [shape=box];
        "no の道" [shape=box];

        "二択の判断?" -> "yes の道" [label="yes"];
        "二択の判断?" -> "no の道" [label="no"];

        "多肢の判断?" [shape=diamond];
        "選択肢 A" [shape=box];
        "選択肢 B" [shape=box];
        "選択肢 C" [shape=box];

        "多肢の判断?" -> "選択肢 A" [label="条件 A"];
        "多肢の判断?" -> "選択肢 B" [label="条件 B"];
        "多肢の判断?" -> "選択肢 C" [label="それ以外"];

        "手順 A の完了" [shape=doublecircle];
        "手順 B の開始" [shape=doublecircle];

        "手順 A の完了" -> "手順 B の開始" [label="起動する", style=dotted];
    }

    // 名前の付け方
    subgraph cluster_naming_patterns {
        label="名前の付け方";

        // 問いは ? で終える
        "X をすべきか?";
        "これは Y にできるか?";
        "Z は真か?";
        "W は済んだか?";

        // 行動は動詞で表す
        "テストを書く";
        "パターンを探す";
        "変更を commit する";
        "助けを求める";

        // コマンドはそのまま書く
        "grep -r 'pattern' .";
        "git status";
        "npm run build";

        // 状態は状況を表す
        "テストが落ちている";
        "ビルドが済んだ";
        "エラーで行き詰まっている";
    }

    // 手順の構造の雛形
    subgraph cluster_structure {
        label="手順の構造の雛形";

        "きっかけ: 何かが起きる" [shape=ellipse];
        "最初の確認?" [shape=diamond];
        "主な行動" [shape=box];
        "git status" [shape=plaintext];
        "次の確認?" [shape=diamond];
        "別の行動" [shape=box];
        "STOP: これはしない" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];
        "手順の完了" [shape=doublecircle];

        "きっかけ: 何かが起きる" -> "最初の確認?";
        "最初の確認?" -> "主な行動" [label="yes"];
        "最初の確認?" -> "別の行動" [label="no"];
        "主な行動" -> "git status";
        "git status" -> "次の確認?";
        "次の確認?" -> "手順の完了" [label="ok"];
        "次の確認?" -> "STOP: これはしない" [label="問題あり"];
        "別の行動" -> "手順の完了";
    }

    // どの形をいつ使うか
    subgraph cluster_shape_rules {
        label="どの形をいつ使うか";

        "形を選ぶ" [shape=ellipse];

        "判断か?" [shape=diamond];
        "ひし形を使う" [shape=diamond, style=filled, fillcolor=lightblue];

        "コマンドか?" [shape=diamond];
        "plaintext を使う" [shape=plaintext, style=filled, fillcolor=lightgray];

        "警告か?" [shape=diamond];
        "八角形を使う" [shape=octagon, style=filled, fillcolor=pink];

        "入口か出口か?" [shape=diamond];
        "二重丸を使う" [shape=doublecircle, style=filled, fillcolor=lightgreen];

        "状態か?" [shape=diamond];
        "楕円を使う" [shape=ellipse, style=filled, fillcolor=lightyellow];

        "既定: 箱を使う" [shape=box, style=filled, fillcolor=lightcyan];

        "形を選ぶ" -> "判断か?";
        "判断か?" -> "ひし形を使う" [label="yes"];
        "判断か?" -> "コマンドか?" [label="no"];
        "コマンドか?" -> "plaintext を使う" [label="yes"];
        "コマンドか?" -> "警告か?" [label="no"];
        "警告か?" -> "八角形を使う" [label="yes"];
        "警告か?" -> "入口か出口か?" [label="no"];
        "入口か出口か?" -> "二重丸を使う" [label="yes"];
        "入口か出口か?" -> "状態か?" [label="no"];
        "状態か?" -> "楕円を使う" [label="yes"];
        "状態か?" -> "既定: 箱を使う" [label="no"];
    }

    // よい例と悪い例
    subgraph cluster_examples {
        label="よい例と悪い例";

        // よい例: 具体的で、形が正しい
        "テストが落ちた" [shape=ellipse];
        "エラーメッセージを読む" [shape=box];
        "再現できるか?" [shape=diamond];
        "git diff HEAD~1" [shape=plaintext];
        "エラーは決して無視しない" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];

        "テストが落ちた" -> "エラーメッセージを読む";
        "エラーメッセージを読む" -> "再現できるか?";
        "再現できるか?" -> "git diff HEAD~1" [label="yes"];

        // 悪い例: 曖昧で、形が誤っている
        bad_1 [label="何かがおかしい", shape=box];  // 状態なので楕円にする
        bad_2 [label="直す", shape=box];  // 曖昧すぎる
        bad_3 [label="確認", shape=box];  // 判断なのでひし形にする
        bad_4 [label="コマンドを実行", shape=box];  // 実際のコマンドを plaintext で書く

        bad_1 -> bad_2;
        bad_2 -> bad_3;
        bad_3 -> bad_4;
    }
}
