{
  "description": "セッションの開始時に cleanshot-capture を plugin の data ディレクトリへ建てる (ソースが変わったときだけ)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_DATA=\"${CLAUDE_PLUGIN_DATA}\" \"${CLAUDE_PLUGIN_ROOT}/scripts/build-cleanshot-capture.sh\" --if-stale",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
